{
	"compilerOptions": {
		"module": "ESNext",
		"target": "ES2015",
		"moduleResolution": "node",
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"skipLibCheck": true,
		"strict": false,
		"lib": ["ES2015", "ES2017", "DOM"],
		"types": [],
		"baseUrl": ".",
		"typeRoots": ["./types", "./node_modules/@types"],
		"paths": {
			"db://*": ["./db/*"],
			"cc": ["./types/cc.d.ts"]
		},
		"useDefineForClassFields": false
	},
	"include": ["assets/**/*.ts", "types/**/*.d.ts"],
	"exclude": ["node_modules", "library", "local", "temp", "build", "native"]
}
