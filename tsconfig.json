{
	"compilerOptions": {
		"module": "ESNext",
		"target": "ES2015",
		"moduleResolution": "node",
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"skipLibCheck": true,
		"strict": false,
		"lib": ["ES2015", "ES2017", "DOM"],
		"types": [],
		"baseUrl": ".",
		"paths": {
			"db://*": ["./db/*"]
		},
		"useDefineForClassFields": false
	},
	"exclude": ["node_modules", "library", "local", "temp", "build", "native"]
}
